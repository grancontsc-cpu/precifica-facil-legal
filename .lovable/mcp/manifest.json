{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://gayqsinndhkxoscxxujj.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "precifica-facil",
      "version": "0.1.0",
      "title": "Precifica Fácil"
    },
    "tools": [
      {
        "name": "simular_preco",
        "title": "Simular preço de venda",
        "description": "Calcula o preço de venda recomendado com o mesmo motor do simulador (modo rápido): usa as alíquotas de ICMS internas e interestaduais cadastradas e trata o ICMS de fronteira como crédito (Lucro Real/Presumido) ou custo puro (Simples/MEI). Resultado aproximado — a versão completa permite mais premissas.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "produto": {
              "type": "string",
              "minLength": 1,
              "description": "Nome do produto."
            },
            "valor_unitario": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Valor unitário de compra, em reais."
            },
            "quantidade": {
              "default": 1,
              "description": "Quantidade comprada.",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "margem_desejada": {
              "default": 30,
              "description": "Margem desejada, em %.",
              "type": "number",
              "minimum": 0,
              "maximum": 99
            },
            "uf_origem": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2,
              "description": "UF de origem da mercadoria (ex.: RJ)."
            },
            "uf_destino": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2,
              "description": "UF de destino / da empresa (ex.: BA)."
            },
            "regime": {
              "default": "real",
              "description": "Regime tributário da empresa compradora.",
              "type": "string",
              "enum": [
                "real",
                "presumido",
                "simples",
                "mei"
              ]
            }
          },
          "required": [
            "produto",
            "valor_unitario",
            "uf_origem",
            "uf_destino"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "listar_produtos",
        "title": "Listar produtos",
        "description": "Lista os produtos cadastrados nas empresas visíveis para o usuário conectado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "busca": {
              "description": "Texto no nome, SKU ou NCM.",
              "type": "string",
              "maxLength": 100
            },
            "limite": {
              "default": 20,
              "description": "Quantidade máxima de registros.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "listar_simulacoes",
        "title": "Listar simulações",
        "description": "Lista as simulações de precificação visíveis para o usuário conectado, com filtro por texto e status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "busca": {
              "description": "Texto no título ou no nome do produto.",
              "type": "string"
            },
            "status": {
              "description": "Filtra pelo status da simulação.",
              "type": "string",
              "enum": [
                "rascunho",
                "final",
                "arquivada"
              ]
            },
            "limite": {
              "default": 10,
              "description": "Quantidade máxima de registros.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "detalhar_simulacao",
        "title": "Detalhar simulação",
        "description": "Retorna uma simulação com as premissas e o resultado gravados (snapshots imutáveis), incluindo o perfil tributário usado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "ID da simulação."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
