# Precifica Grancont — variáveis de ambiente de exemplo
# Copie para .env e preencha. Apenas variáveis públicas ficam aqui.
# Chaves privadas (chave de serviço do backend, LOVABLE_API_KEY, segredos de
# integrações) são gerenciadas no painel do projeto e NUNCA versionadas.

# Backend (valores públicos, expostos ao navegador)
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="seu-project-id"

# Google Analytics (opcional — carregado só após consentimento de cookies)
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
